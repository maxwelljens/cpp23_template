# ── Guarded C++23 clang-tidy Configuration ─────────────────────────────────
#   Requires clang-tidy ≥ 19 for C++23 support.
#   Enable with: cmake -DEXAMPLE_ENABLE_CLANG_TIDY=ON -B build

Checks: >
  -*,
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -bugprone-reserved-identifier

WarningsAsErrors: '*'

CheckOptions:
  cppcoreguidelines-pro-bounds-array-to-pointer-decay: true
  cppcoreguidelines-pro-bounds-pointer-arithmetic: true
  cppcoreguidelines-owning-memory: true
  cppcoreguidelines-pro-type-cstyle-cast: true
